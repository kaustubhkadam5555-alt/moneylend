# ============================================================
# MoneyLend - Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your environment.
# Note: .env is ignored by Git to protect sensitive credentials.
# ============================================================

# Application Environment (development, production)
APP_ENV=development

# Email Notification Architecture Configuration
# Supported MAIL_MODE options:
# - log: Safely log rendered email payloads to logs/mail.log without sending (Recommended for local XAMPP)
# - disabled: Completely bypass outgoing email notifications
# - smtp: Send via configured SMTP server
MAIL_MODE=log

# SMTP Server Credentials (Required only when MAIL_MODE=smtp)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@moneylend.local
MAIL_FROM_NAME="MoneyLend Alerts"
