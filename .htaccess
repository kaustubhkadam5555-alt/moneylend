# ============================================================
# MoneyLend — Production Apache Configuration (.htaccess)
# ============================================================

# Disable directory browsing
Options -Indexes

# Set default character encoding
AddDefaultCharset UTF-8

# Protect sensitive files, dot files, migrations, and logs from direct HTTP access
<FilesMatch "^\.|\.(env|sql|log|dump|bak|tmp|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly deny direct access to database scripts and scratch directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database/ - [F,L]
    RewriteRule ^logs/ - [F,L]
</IfModule>

# Defense-in-depth security headers (when mod_headers is available)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
